# —— 模型凭证（见 8.5 凭证安全：仅网关进程可见，业务组件不可见）——

# 方式一：静态 API Key（sk- 开头 → x-api-key 鉴权）
MINIMAX_API_KEY=
# 方式二：OAuth 凭证文件（运行时动态读取 accessToken，令牌轮换无需改配置重启）
#         LLM_CREDENTIAL_FILE=/path/to/auth.json
#         务必用 LLM_CREDENTIAL_PROVIDERS 限定适用 provider，防止令牌外泄到第三方域名
LLM_CREDENTIAL_FILE=
LLM_CREDENTIAL_PROVIDERS=minimax
# MiniMax 静态 Key 默认 x-api-key；OpenAI/Qwen/DeepSeek/Zhipu 默认 Bearer。
# 可用 MINIMAX_AUTH_MODE / OPENAI_AUTH_MODE 等按 Provider 覆盖（auto | bearer | x-api-key）。
LLM_AUTH_MODE=auto

# —— Provider 接入（见 4.4 商业大模型接入与 Key 管理）——
MINIMAX_BASE_URL=https://agent.minimaxi.com/mavis/api/v1/llm/v1
MINIMAX_PROTOCOL=anthropic
# 账号池（每 Provider 开 2+ 子账号，见 4.4 Key 治理第 1 条）
# MINIMAX_API_KEY_2=
# MINIMAX_API_KEY_3=

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# —— 出网白名单（见 8.3 出网安全：仅这些域名可出网）——
EGRESS_ALLOWED_HOSTS=agent.minimaxi.com,api.openai.com,dashscope.aliyuncs.com,api.deepseek.com,open.bigmodel.cn
# 出网代理地址（Envoy），生产必配
EGRESS_PROXY_URL=

# —— 虚拟模型与 Failover 链（见 4.3 / 4.4）——
# EAP_VIRTUAL_MODELS_JSON=[{"name":"smart-model","targets":[...],"scenarios":[...],"enabled":true}]

# —— 计价表（USD / 千 token，见 11.2 成本管理）——
# PRICING_JSON={"MiniMax-M3.1-Flash":{"input":0.0005,"output":0.0015}}

# —— 身份（见 3.1 身份组件 / 7.1 身份链路）——
AUTH_DEV_MODE=true
AUTH_DEV_SECRET=change-me-in-production
AUTH_SINGLE_TENANT_MODE=true
AUTH_DEFAULT_TENANT_ID=t-default
KEYCLOAK_BASE_URL=http://127.0.0.1:8081
KEYCLOAK_REALM=enterprise
# KEYCLOAK_JWKS_URI=
# KEYCLOAK_ISSUER=
# KEYCLOAK_AUDIENCE=
# 组件间内部调用的服务账号（client_credentials）。
# AUTH_DEV_MODE=false 时必须配置 —— MCP Hub / agent-core 回调网关靠它拿令牌。
# KEYCLOAK_SERVICE_CLIENT_ID=eap-agent
# KEYCLOAK_SERVICE_CLIENT_SECRET=change-me-in-production
# 网关用户管理面（独立 eap-gateway 客户端，仅 view-users / manage-users）。
# 本地演示缺省与 realm-eap.json 一致；生产必须设置独立 Secret。
# KEYCLOAK_USER_ADMIN_CLIENT_ID=eap-gateway
# KEYCLOAK_USER_ADMIN_CLIENT_SECRET=change-me-in-production
# 无法走 OIDC 的第三方组件直调网关时使用，格式：<凭证>:<角色>:<租户>:<部门>:<密级>。
# AUTH_SERVICE_TOKENS=change-me-component:employee:t-default:dept-general:internal
# RAGFlow 批量配置脚本会读取这里的按账号凭证；生产环境应使用不同凭证映射到对应身份。
# 未配置时回退到 RAGFLOW_GATEWAY_KEY / 本地演示共用凭证，平台审计无法区分 RAGFlow 用户。
# RAGFLOW_GATEWAY_KEY_EAP_ADMIN=
# RAGFLOW_GATEWAY_KEY_EAP_OPS=
# RAGFLOW_GATEWAY_KEY_EAP_MANAGER=
# RAGFLOW_GATEWAY_KEY_EAP_DEMO=
# RAGFLOW_GATEWAY_KEY_EAP_ADMIN_LOCAL=

# —— 存储（见 3.1 存储组件）——
STORE_KIND=metadata            # metadata=SQLite | postgres
STORE_SQLITE_PATH=./data/platform.db
# POSTGRES_URL=postgres://eap:eap@127.0.0.1:5432/eap
CACHE_KIND=memory              # memory | redis（多副本生产使用 redis）
# REDIS_URL=redis://:change-me@127.0.0.1:6379
OBJECT_STORE_KIND=fs           # fs | minio
OBJECT_STORE_FS_ROOT=./data/objects
# MINIO_ENDPOINT=127.0.0.1
# MINIO_PORT=9000
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_BUCKET=eap-audit
OBJECT_STORE_VERSIONING=true

# —— 观测（见 3.1 观测组件 / 4.3 OTel 埋点）——
# OTLP 端点需含 /api/public/otel 前缀，实际请求路径为 {base}/v1/traces
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:3001/api/public/otel
OTEL_SERVICE_NAME=agentgateway
OTEL_EXPORT_TIMEOUT_MS=3000
# Langfuse 凭证（OTLP 用 Basic 鉴权，pk-lf-xxx / sk-lf-xxx）
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
LANGFUSE_INGESTION_VERSION=4
EAP_ENVIRONMENT=local
LOCAL_TRACE_DIR=./data/traces

# —— 本地嵌入与检索（见 4.2 知识库与检索层 / 数据不出域）——
# TEI 与 Infinity 只允许环回与私有网段地址，绝不借用商业 API 出网白名单
TEI_BASE_URL=http://127.0.0.1:6380
# INFINITY_BASE_URL=http://127.0.0.1:23821
# INFINITY_DATABASE=eap_kb

# —— MCP Server 注册（见 4.3 MCP Federation）——
MCP_SERVERS=knowledge=http://127.0.0.1:8091/mcp,chatbi=http://127.0.0.1:8092/mcp,business=http://127.0.0.1:8093/mcp
MCP_TIMEOUT_MS=60000

# —— 服务端口 ——
GATEWAY_PORT=8080
AGENT_PORT=8090
GATEWAY_API_ROOT=http://127.0.0.1:8080
GATEWAY_OPENAI_BASE_URL=http://127.0.0.1:8080/v1
WEBUI_PORT=5173

# —— 监听地址 ——
# 默认只绑回环，避免网关/Agent/MCP 工具目录直接暴露在局域网与公网。
# 确需容器间互访时由 deploy/compose/docker-compose.yml 显式覆盖为 0.0.0.0，
# 这里不要改成 0.0.0.0。
GATEWAY_HOST=127.0.0.1
AGENT_HOST=127.0.0.1
MCP_HUB_HOST=127.0.0.1
WEBUI_HOST=127.0.0.1

# —— 部署环境参数 ——
# 公网 IP（宿主持有）。仓库不内置真实值（公开仓库不应公布目标地址），
# 实际取值见内部参数表 docs/internal/host-params.local.md，
# 或用 ./scripts/gen-host-params.sh [公网IPv4] [办公出口CIDR] 生成。
#
# 本文件由 scripts/start-all.sh 以 shell source 方式加载（set -a; . ./.env），
# 因此**可以引用 ${EAP_PUBLIC_IP} 自动展开** —— 公网地址只在这一处维护。
# ⚠ 若在下面用它派生别的配置，该行必须定义在使用它的行**之前**，否则展开成空。
#
# 用途：
#   1) 派生多入口 issuer 列表（浏览器从公网访问时 token 的 iss 就是公网地址，
#      漏掉该入口会导致对应令牌被判 issuer 不匹配而 401）：
#        KEYCLOAK_ISSUER=http://127.0.0.1:8082/realms/enterprise,http://${EAP_PUBLIC_IP}:8082/realms/enterprise,http://keycloak:8080/realms/enterprise
#   2) scripts/parse-portscan.py 与 scripts/verify-secure-context-pkce.mjs 的目标地址。
EAP_PUBLIC_IP=
# 办公出口白名单；单个 IP 使用 /32，禁止设为 0.0.0.0/0。
EAP_OFFICE_CIDR=

# —— 运行参数 ——
LOG_LEVEL=info
EAP_DATA_DIR=./data
# CHATBI_RESET_DEMO=false  # 仅显式设为 true 时才重建演示库；默认保留已有数据
AGENT_MAX_ITERATIONS=8
# 未显式选择模型时使用的虚拟模型；Agent 与网关保持一致
AGENT_DEFAULT_MODEL=smart-model
AGENT_MAX_HISTORY_MESSAGES=32
AGENT_MAX_HISTORY_CHARS=32000
AGENT_MAX_TOOL_RESULT_CHARS=20000
AGENT_RAG_TOP_K=5
AGENT_APPROVAL_TIMEOUT_MS=300000
BUDGET_PLATFORM_MONTHLY_USD=500
BUDGET_TENANT_OVERRUN_ACTION=circuit_break
GUARDRAILS_PII_MASKING=true
GUARDRAILS_INJECTION_DETECTION=true
GUARDRAILS_BLOCK_CONFIDENTIAL_EGRESS=true
# GUARDRAILS_CUSTOM_RULES_FILE=./deploy/guardrails-rules.json
# POLICY_FILE=./deploy/policies.json

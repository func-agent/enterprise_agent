# =============================================================================
# 企业级 AI Agent 平台 —— Docker Compose 环境变量清单
#
# 用法：
#   cp .env.example .env   然后按注释逐项填写真实值，再执行 docker compose up -d
#
# 约定：
#   · 所有默认值均为占位符（CHANGE_ME_*），上线前必须替换
#   · 商业模型 API Key 只注入 agentgateway 容器，其它组件不可见（见 8.5 凭证安全）
#   · 生产环境建议改用 K8s Secret / 企业密钥管理流程，3.2 明确不引入 Vault
# =============================================================================

# -----------------------------------------------------------------------------
# 一、模型凭证（仅 agentgateway 进程可见，见 8.5 凭证安全）
# -----------------------------------------------------------------------------
# 通义千问 DashScope API Key
QWEN_API_KEY=
# DeepSeek API Key
DEEPSEEK_API_KEY=
# 智谱 GLM API Key
ZHIPU_API_KEY=
# OpenAI API Key
OPENAI_API_KEY=
# MiniMax API Key（本地凭证文件模式可留空，改用 LLM_CREDENTIAL_FILE）
MINIMAX_API_KEY=

# 各 Provider 的 OpenAI 兼容接入地址（经出网代理访问，见 8.3）
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
OPENAI_BASE_URL=https://api.openai.com/v1
MINIMAX_BASE_URL=https://agent.minimaxi.com/mavis/api/v1/llm/v1
# Provider 协议：anthropic = Anthropic Messages 协议，openai = Chat Completions
MINIMAX_PROTOCOL=anthropic

# OAuth 形态的凭证文件路径（容器内挂载路径），令牌轮换无需改配置
LLM_CREDENTIAL_FILE=
# 允许使用该凭证文件的 Provider 白名单，必须显式限定
LLM_CREDENTIAL_PROVIDERS=minimax
# 凭证鉴权方式：auto / bearer / x-api-key
LLM_AUTH_MODE=auto

# -----------------------------------------------------------------------------
# 二、网关配置（agentgateway，见 4.3 核心能力）
# -----------------------------------------------------------------------------
# 平台标识，用于平台级预算与 Trace
EAP_PLATFORM_ID=eap-main
# 日志级别：debug / info / warn / error
LOG_LEVEL=info
# 网关对外端口（OpenAI 兼容接口 / MCP 治理 / 管理面）
GATEWAY_PORT=8080
# AgentScope Service 端口
AGENT_PORT=8090
# Web UI 静态服务端口
WEBUI_PORT=5173
# 单次 LLM 请求超时（毫秒）
LLM_TIMEOUT_MS=120000
# 同一 Provider 内部重试次数（跨 Provider 由网关 Failover 负责）
LLM_MAX_RETRIES=1
# 网关全局 QPS 限流
LLM_DEFAULT_QPS=20
# 平台级月度预算上限（USD / Token）
BUDGET_PLATFORM_MONTHLY_USD=500
BUDGET_PLATFORM_MONTHLY_TOKENS=100000000
# 租户超限动作：alert / throttle / circuit_break
BUDGET_TENANT_OVERRUN_ACTION=circuit_break
# 预算预警阈值（已用比例）
BUDGET_ALERT_RATIO=0.8
# 元数据存储：sqlite（POC，默认）或 postgres（生产）
STORE_KIND=sqlite
# MCP Server 注册表（全部经网关收口，见 2.1 单一网关）
MCP_SERVERS=knowledge=http://mcp-hub:8091/mcp,chatbi=http://mcp-hub:8092/mcp,business=http://mcp-hub:8093/mcp
MCP_TIMEOUT_MS=60000
# MCP Hub 三个端口（文档检索 / ChatBI / 业务工具）
MCP_KNOWLEDGE_PORT=8091
MCP_CHATBI_PORT=8092
MCP_BUSINESS_PORT=8093

# —— AgentScope Service 运行参数（见 4.1 ReAct + HITL）
# ReAct 最大迭代轮数
AGENT_MAX_ITERATIONS=8
# 未显式选择模型时使用的虚拟模型；同步注入 Agent 与网关
AGENT_DEFAULT_MODEL=smart-model
# RAG 检索 Top-K，控制 Token 成本（见 11.2 上下文压缩）
AGENT_RAG_TOP_K=5
# HITL 人工确认超时（毫秒）
AGENT_APPROVAL_TIMEOUT_MS=300000

# -----------------------------------------------------------------------------
# 三、身份（Keycloak 26，见 3.1 身份组件 / 7.1 身份与多租户）
# -----------------------------------------------------------------------------
# Keycloak 宿主机端口（容器内固定 8080）
KEYCLOAK_PORT=8081
# Keycloak 永久系统管理员（master realm，能管所有 realm）。
#   start-heavy.sh 启动 keycloak 后自动执行 keycloak-admin.py ensure-admin：
#   通过 Admin REST API 创建永久管理员、验证 admin 角色，再删除临时引导账号。
#   已存在永久管理员时幂等跳过，不会重置口令。
#   ⚠️ 口令不写进仓库 —— 本文件里只放占位符，实际值填在本机 .env。
# scripts/keycloak-admin.py 默认读取这两项；也可用 KC_ADMIN_USER / KC_ADMIN_PASSWORD 覆盖。
KEYCLOAK_ADMIN=kc-admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_keycloak_admin_password
# 仅在 keycloak-data 数据卷为空的首次启动时使用，必须与永久管理员不同名。
# 初始口令与 KEYCLOAK_ADMIN_PASSWORD 相同；永久管理员验证成功后该账号会被删除。
KEYCLOAK_BOOTSTRAP_ADMIN=eap-bootstrap
# 租户 realm 名称，需与 keycloak/realm-eap.json 中的 realm 一致
KEYCLOAK_REALM=enterprise
# 网关用户管理面客户端（仅 enterprise realm 的 view-users / manage-users）。
KEYCLOAK_USER_ADMIN_CLIENT_ID=eap-gateway
KEYCLOAK_USER_ADMIN_CLIENT_SECRET=CHANGE_ME_gateway_user_admin_secret
# 公网 Web 控制台入口（协议 + 主机 + 端口），按实际部署地址填写。
#   keycloak/realm-eap.json 的 redirectUris / webOrigins / 登出跳转用
#   ${EAP_PUBLIC_WEB_ORIGIN} 占位，realm 导入时由本变量替换。
#   仅本机访问时保持默认；开放公网后改为实际对外地址，例如
#   http://<公网IP或域名>:5173
# 注意：变量缺失时 Keycloak 会把占位符原样写进 redirect URI 且不告警，
# scripts/start-heavy.sh 会在启动前强制校验，未设置直接拒绝启动。
EAP_PUBLIC_WEB_ORIGIN=http://127.0.0.1:5173

# ── RAGFlow 的 Keycloak SSO（可选；4 个变量全空则不启用 SSO）────────────
# 公网 Keycloak 入口：RAGFlow 登录时浏览器跳转的授权地址（浏览器侧）。
#   仅本机访问时用回环地址；开放公网后改为实际对外地址，例如
#   http://<公网IP或域名>:8082
EAP_PUBLIC_KEYCLOAK_ORIGIN=http://127.0.0.1:8082
# 公网 RAGFlow 入口：SSO 回调地址为 http://<本地址>/v1/user/oauth/callback/keycloak。
#   同时用于 keycloak/realm-eap.json 中 eap-ragflow 客户端的 redirectUris / webOrigins
#   占位替换，必须与浏览器实际访问 RAGFlow 的地址完全一致，
#   否则 Keycloak 会以 invalid_redirect_uri 拒绝回调。
EAP_PUBLIC_RAGFLOW_ORIGIN=http://127.0.0.1:8095
# Keycloak 侧的 RAGFlow 客户端，需与 keycloak/realm-eap.json 的 eap-ragflow 一致
RAGFLOW_OAUTH_CLIENT_ID=eap-ragflow
# 开发用明文密钥。首次导入 realm 与 RAGFlow 共用此值；已有 realm 不会被重新导入覆盖。
# 轮换已有客户端：python3 scripts/keycloak-admin.py rotate-secret enterprise eap-ragflow
# 将命令生成的新密钥填到这里，再重建 RAGFlow **与 Keycloak**（env 变更需 recreate）；
# 详见 keycloak/README.md。
RAGFLOW_OAUTH_CLIENT_SECRET=eap-ragflow-local-secret-2026
# RAGFlow 的第三方登录渠道名，默认 keycloak。
#   改这个值要同步改 deploy/compose/ragflow/nginx/login-sso.html 里的
#   /v1/user/login/<渠道名>，否则容器启动时会因渠道不一致直接退出。
# RAGFLOW_SSO_CHANNEL=keycloak
# 后端侧（换 token / 拉 userinfo）使用的 Keycloak 基址，留空 = 跟随上面的公网地址。
#   默认留空是对的：Keycloak 动态 hostname 下令牌 iss 跟随签发时的请求 Host，
#   后端侧若改用容器内 keycloak:8080，userinfo 会因 iss 不匹配返回 401。
#   只有 Keycloak 改成固定 hostname（KC_HOSTNAME + hostname-backchannel-dynamic）
#   后，才建议填内部地址以避免后端绕公网。
# RAGFLOW_OAUTH_KEYCLOAK_BACKEND=
# 外部可见的 realm issuer：必须与浏览器拿到的 token 中 iss 完全一致，否则 JWT 校验失败
#   POC 走宿主机端口时：http://localhost:8081/realms/enterprise
#   生产走网关域名时：https://sso.example.com/realms/enterprise
KEYCLOAK_ISSUER=http://localhost:8081/realms/enterprise
# 受众校验（留空表示不校验 audience）
KEYCLOAK_AUDIENCE=
# JWKS 端点（留空则由 KEYCLOAK_BASE_URL + realm 自动推导）
KEYCLOAK_JWKS_URI=
# 是否允许开发用本地自签 dev token：生产必须为 false
AUTH_DEV_MODE=false
# 首期单租户 + 部门隔离模式（见 7.3）
AUTH_SINGLE_TENANT_MODE=true
AUTH_DEFAULT_TENANT_ID=t-default

# -----------------------------------------------------------------------------
# 四、存储（见 3.1 存储组件）
# -----------------------------------------------------------------------------
# —— PostgreSQL 16：全平台元数据
POSTGRES_USER=eap
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_DB=eap
POSTGRES_PORT=5432
POSTGRES_MAX_CONNECTIONS=200
POSTGRES_SHARED_BUFFERS=256MB

# —— Redis 7：会话 / 队列 / 缓存
REDIS_PASSWORD=CHANGE_ME_redis_password
REDIS_PORT=6379
REDIS_MAXMEMORY=1gb

# —— MinIO：原始文档 / 审计归档（开启版本化，见 9.4）
MINIO_ROOT_USER=eapadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# 审计归档桶名（网关审计留痕落这里）
MINIO_BUCKET=eap-audit
# Langfuse 事件 / 批量导出桶
LANGFUSE_BUCKET=langfuse
# RAGFlow 原始文档桶
RAGFLOW_BUCKET=ragflow
MINIO_REGION=us-east-1

# —— ClickHouse v3：Langfuse 依赖
CLICKHOUSE_USER=eap
CLICKHOUSE_PASSWORD=CHANGE_ME_clickhouse_password
CLICKHOUSE_DB=langfuse
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

# —— MySQL：仅 RAGFlow v0.22 自身元数据（平台元数据仍在 PostgreSQL）
RAGFLOW_MYSQL_DBNAME=rag_flow
RAGFLOW_MYSQL_PASSWORD=CHANGE_ME_ragflow_mysql_password

# —— DB-GPT 元数据库（建在同一个 PostgreSQL 实例的独立库）
DBGPT_DATABASE=dbgpt

# -----------------------------------------------------------------------------
# 五、出网安全（见 8.3 出网安全 / 9.3 网络要求）
# -----------------------------------------------------------------------------
# SNI 白名单（逗号分隔）：只有列表内域名可以出网，其余一律 403
EGRESS_ALLOWED_HOSTS=api.openai.com,dashscope.aliyuncs.com,api.deepseek.com,open.bigmodel.cn,agent.minimaxi.com
# 网关使用的出网代理地址（容器内地址）
EGRESS_PROXY_URL=http://envoy:15000
# 出网代理端口：15000 = HTTP 正向代理，15001 = HTTPS 代理（TLS 解密审计）
ENVOY_HTTP_PORT=15000
ENVOY_HTTPS_PORT=15001
ENVOY_ADMIN_PORT=9901

# -----------------------------------------------------------------------------
# 六、观测（Langfuse v3，见 3.1 观测组件）
# -----------------------------------------------------------------------------
LANGFUSE_PORT=3000
LANGFUSE_DATABASE=langfuse
# Langfuse 加密盐值 / 会话密钥 / 加密密钥（生产必须替换，24 字节以上随机串）
LANGFUSE_SALT=eap-local-lf-salt-2026-abcdef0123456789
LANGFUSE_ENCRYPTION_KEY=6ba3cc7fc7fa03fed8fda582c53d6bff1b0b5c0aa2ada889e01c1503656906c5
NEXTAUTH_SECRET=CHANGE_ME_nextauth_secret
# OTLP 导出端点（网关 / AgentScope → Langfuse）
OTEL_EXPORTER_OTLP_ENDPOINT=http://langfuse-web:3000/api/public/otel

# -----------------------------------------------------------------------------
# 七、知识层（见 4.2 / 9.4）
# -----------------------------------------------------------------------------
# RAGFlow 端口（API 9380 / Web UI 80）
RAGFLOW_HTTP_PORT=9380
RAGFLOW_WEB_PORT=80
# Infinity 端口（Thrift 客户端 23817 / HTTP 23820）
INFINITY_CLIENT_PORT=23817
INFINITY_HTTP_PORT=23820
# 本地 Embedding 模型（TEI，见 4.2 关键决策：数据不出域、CPU 即可）
TEI_MODEL=intfloat/multilingual-e5-small
TEI_PORT=6380
# 离线环境：模型目录挂载到容器 /data 后，填该目录名（留空表示从模型仓在线拉取）
TEI_MODEL_PATH=/data/model

# -----------------------------------------------------------------------------
# 八、ChatBI（见 3.1「DB-GPT：以 MCP Server 暴露」）
# -----------------------------------------------------------------------------
# 宿主端口 8099 —— 避开 mcp-hub 的 chatbi MCP(8092) 与重型栈 db-gpt(8094/8096/8097)
DBGPT_PORT=8099
# DB-GPT 镜像：固定版本标签，不用 :latest（构建见 deploy/compose/dbgpt/Dockerfile）
DBGPT_IMAGE=eapheavy/dbgpt:0.8.3-pg
# DB-GPT 的 MCP Server 启动命令。
#   多数版本提供 MCP Server 入口；若所选版本未内置，用下面的 webserver 形态替代：
#   dbgpt start webserver --config /app/configs/dbgpt-proxy-openai.toml
DBGPT_MCP_COMMAND=dbgpt mcp server --host 0.0.0.0 --port 8092

# -----------------------------------------------------------------------------
# 九、镜像与版本（见 3.1 组件清单；离线环境改写为 Harbor 前缀，见 README）
# -----------------------------------------------------------------------------
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine
MINIO_IMAGE=minio/minio:latest
MINIO_MC_IMAGE=minio/mc:RELEASE.2025-04-16T18-13-26Z
CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:24.8-alpine
MYSQL_IMAGE=mysql:8.0.39
LANGFUSE_IMAGE=langfuse/langfuse:3.63.0
LANGFUSE_WORKER_IMAGE=langfuse/langfuse-worker:3.63.0
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.0
RAGFLOW_IMAGE=infiniflow/ragflow:v0.22.1
INFINITY_IMAGE=infiniflow/infinity:v0.7.5-x64-v2
TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.8
ENVOY_IMAGE=envoyproxy/envoy:v1.31-latest

# 平台自研组件镜像（本地构建）
GATEWAY_IMAGE=eap/agentgateway:1.0.0
AGENT_IMAGE=eap/agent-core:1.0.0
MCP_HUB_IMAGE=eap/mcp-hub:1.0.0
WEBUI_IMAGE=eap/webui:1.0.0
# Node.js 运行时版本（自研镜像构建用）
NODE_VERSION=22

# -----------------------------------------------------------------------------
# 十、资源限制（单机 POC，按 9.1 硬件配置 16C/32G 分配）
# -----------------------------------------------------------------------------
POSTGRES_MEM_LIMIT=2g
POSTGRES_CPUS=1.0
REDIS_MEM_LIMIT=1g
REDIS_CPUS=0.5
MINIO_MEM_LIMIT=2g
MINIO_CPUS=1.0
MINIO_INIT_MEM_LIMIT=256m
MINIO_INIT_CPUS=0.3
CLICKHOUSE_MEM_LIMIT=4g
CLICKHOUSE_CPUS=1.5
MYSQL_MEM_LIMIT=2g
MYSQL_CPUS=1.0
LANGFUSE_MEM_LIMIT=2g
LANGFUSE_CPUS=1.0
LANGFUSE_WORKER_MEM_LIMIT=1g
LANGFUSE_WORKER_CPUS=0.5
KEYCLOAK_MEM_LIMIT=2g
KEYCLOAK_CPUS=1.0
INFINITY_MEM_LIMIT=4g
INFINITY_CPUS=2.0
TEI_MEM_LIMIT=4g
TEI_CPUS=2.0
RAGFLOW_MEM_LIMIT=8g
RAGFLOW_CPUS=4.0
DBGPT_MEM_LIMIT=4g
DBGPT_CPUS=2.0
ENVOY_MEM_LIMIT=512m
ENVOY_CPUS=1.0
GATEWAY_MEM_LIMIT=1g
GATEWAY_CPUS=1.0
AGENT_MEM_LIMIT=1g
AGENT_CPUS=1.0
MCP_HUB_MEM_LIMIT=512m
MCP_HUB_CPUS=0.5
WEBUI_MEM_LIMIT=256m
WEBUI_CPUS=0.5

# -----------------------------------------------------------------------------
# 十一、命名与时区
# -----------------------------------------------------------------------------
# 容器网络 / 数据卷名前缀（多套环境并行时区分）
NETWORK_PREFIX=eap
VOLUME_PREFIX=eap
TZ=Asia/Shanghai

# Langfuse 浏览器访问地址（宿主端口 3001）
NEXTAUTH_URL=http://127.0.0.1:3001
